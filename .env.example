DATABASE_URL="file:./prisma/dev.db"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="minimum-thirty-two-characters-long-secret"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Yakındaki yerler OpenStreetMap/Overpass ile gelir; ek API anahtarı gerekmez.

# 101evler XML feed (token korumalı)
# /api/feeds/101evler.xml?token=<bu değer> — 101evler hesap yöneticisine verilir.
FEED_101EVLER_TOKEN="change-me-to-a-32-char-random-string"

# Hangiev XML feed (token korumalı)
# /api/feeds/hangiev.xml?token=<bu değer> — Hangiev hesap yöneticisine verilir.
FEED_HANGIEV_TOKEN="change-me-to-a-32-char-random-string"
NEXT_PUBLIC_SITE_URL="https://www.alfaemlak.com"

# AI satış danışmanı (Gemini) — ayrıca ilan detayında dil değişince eksik çeviriler otomatik doldurulur
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# E-posta (Resend) — panel giriş kodu (2FA) ve geçici şifre maili
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="onboarding@resend.dev"
# Müşteri "Yanıtla" dediğinde gideceği adres (boş bırakılırsa EMAIL_FROM'a gider)
EMAIL_REPLY_TO=""
